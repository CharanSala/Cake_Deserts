{
  "name": "eclat-desserts",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ÉCLAT – The Art of Desserts. Luxury 3D artisan patisserie showroom built with React, Three.js, React Three Fiber, GSAP, and Blender.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
